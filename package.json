{
  "name": "webapp",
  "version": "20.3.19",
  "description": "Build web app use Angular + Material, tailwindcss with base setup. Support many build mode as SPA, SSR, SPA + localize, SSR + localize, see README.md",
  "author": {
    "name": "DN"
  },
  "keywords": [
    "Angular",
    "Angular Material",
    "Angular app structure",
    "Angular app structure template"
  ],
  "private": false,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "serve:public": "ng serve --host=0.0.0.0 --port=7777",
    "start": "ng serve",
    "dev": "ng serve --configuration=dev",
    "dev:vi": "ng serve --configuration=dev-vi",
    "dev:ssr:vi": "ng serve --configuration=dev-ssr-vi",
    "i18n": "ng extract-i18n",
    "build": "ng build",
    "build:i18n": "ng build --localize --output-path=dist/ssr-i18n",
    "build:spa": "ng build --configuration=spa",
    "build:i18n:spa": "ng build --configuration=spa-i18n",
    "watch": "ng build --watch --configuration dev",
    "test": "ng test",
    "serve:ssr:v18m3": "node dist/v18m3/server/server.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/animations": "^20.3.19",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.19",
    "@angular/compiler": "^20.3.19",
    "@angular/core": "^20.3.19",
    "@angular/forms": "^20.3.19",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.19",
    "@angular/platform-browser-dynamic": "^20.3.19",
    "@angular/platform-server": "^20.3.19",
    "@angular/router": "^20.3.19",
    "@angular/ssr": "^20.3.25",
    "express": "^4.21.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.25",
    "@angular/cli": "^20.3.25",
    "@angular/compiler-cli": "^20.3.19",
    "@angular/localize": "^20.3.19",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "husky": "^9.1.6",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^15.2.10",
    "ng-extract-i18n-merge": "^2.13.1",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.{ts,js,html,scss,css}": "prettier --write"
  }
}
